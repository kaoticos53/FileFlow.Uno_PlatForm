<UserControl
    x:Class="FileFlow.App.Uno.Controls.SplashScreenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="540"
    Height="350">

  <Border x:Name="CardBorder"
          Background="{StaticResource CanvasSurfaceBrush}"
          BorderBrush="{StaticResource CanvasBorderBrush}"
          BorderThickness="1"
          CornerRadius="16"
          Padding="32"
          MaxWidth="540"
          MaxHeight="350"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
      <!-- Cabecera: Marca + Producto + Versión -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
        <Border Width="48"
                Height="48"
                CornerRadius="12"
                Background="{StaticResource CanvasAccentPrimaryBrush}">
          <!-- Icono de rayo / Flash vectorizado -->
          <Path Data="M11 15H6L13 1V9H18L11 23V15Z"
                Fill="{StaticResource CanvasOnAccentBrush}"
                Stretch="Uniform"
                Width="22"
                Height="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="FileFlow Studio"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource CanvasTextBrush}" />
          <TextBlock x:Name="TxtVersion"
                     FontSize="12"
                     Foreground="{StaticResource CanvasSecondaryBrush}"
                     Text="v1.0.0" />
        </StackPanel>
      </StackPanel>

      <!-- Contenido central: motor + insignia de nodos -->
      <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
        <TextBlock x:Name="TxtEngine"
                   FontSize="14"
                   Foreground="{StaticResource CanvasSecondaryBrush}"
                   Text="Inicializando Motor de Flujo DAG..." />
        <Border Background="{StaticResource CanvasCardBrush}"
                BorderBrush="{StaticResource CanvasBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,5"
                HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <!-- Icono de cubo / módulo vectorial -->
            <Path Data="M12 2L2 7L12 12L22 7L12 2Z M2 17L12 22L22 17 M2 12L12 17L22 12"
                  Stroke="{StaticResource CanvasAccentGlowBrush}"
                  StrokeThickness="1.5"
                  Width="13"
                  Height="13"
                  Stretch="Uniform"
                  VerticalAlignment="Center" />
            <TextBlock x:Name="TxtNodesBadge"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{StaticResource CanvasAccentGlowBrush}"
                       Text="Cargando nodos..."
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Estado y porcentaje -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <TextBlock x:Name="TxtStatus"
                   Grid.Column="0"
                   FontSize="12"
                   Foreground="{StaticResource CanvasSecondaryBrush}"
                   Text="Construyendo el contenedor de servicios..." />
        <TextBlock x:Name="TxtPercentage"
                   Grid.Column="1"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource CanvasAccentGlowBrush}"
                   Text="0%" />
      </Grid>

      <!-- Barra de progreso -->
      <ProgressBar x:Name="PbProgress"
                   Grid.Row="3"
                   Minimum="0"
                   Maximum="100"
                   Value="0"
                   Height="6"
                   CornerRadius="3"
                   Foreground="{StaticResource CanvasAccentPrimaryBrush}"
                   Background="{StaticResource CanvasBgDarkBrush}" />

      <!-- Pie -->
      <TextBlock x:Name="TxtFooter"
                 Grid.Row="4"
                 FontSize="11"
                 Foreground="{StaticResource CanvasMutedBrush}"
                 HorizontalAlignment="Center"
                 Margin="0,16,0,0"
                 Text="© 2026 RGLara • Cross-Platform Engine" />
    </Grid>
  </Border>
</UserControl>

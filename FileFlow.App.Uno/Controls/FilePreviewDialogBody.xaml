<UserControl
    x:Class="FileFlow.App.Uno.Controls.FilePreviewDialogBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    El PREVISUALIZADOR DE ARCHIVOS del host Uno: cuerpo modal para instantáneas del inspector
    (entradas/salidas) y líneas de registro del log.
    Soporta navegación entre hermanos, comparación visual entre original y procesado,
    renderizado de imágenes, visor de código/texto en monoespaciado, ficha de metadatos
    y acciones rápidas en el sistema operativo.
  -->
  <Grid x:Name="FilePreviewRoot" MinWidth="750" MaxWidth="1050" MinHeight="500" MaxHeight="720" RowSpacing="12"
        AutomationProperties.AutomationId="FilePreviewBody">
    <Grid.RowDefinitions>
      <!-- 0: Cabecera con identidad, insignias y navegación -->
      <RowDefinition Height="Auto" />
      <!-- 1: Área de previsualización y panel de metadatos -->
      <RowDefinition Height="*" />
      <!-- 2: Barra de acciones y pie -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 0. CABECERA -->
    <Grid Grid.Row="0" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Identidad del archivo e insignias -->
      <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="FileIconText" Text="📄" FontSize="18" VerticalAlignment="Center" />
          <TextBlock x:Name="FileNameText" FontSize="15" FontWeight="Bold"
                     Foreground="{StaticResource CanvasTextBrush}"
                     TextTrimming="CharacterEllipsis" MaxWidth="450"
                     VerticalAlignment="Center"
                     AutomationProperties.AutomationId="PreviewFileName" />
        </StackPanel>

        <!-- Insignias de extensión, peso y dimensiones -->
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Background="{StaticResource CanvasAccentPrimaryBrush}" CornerRadius="4" Padding="6,2">
            <TextBlock x:Name="ExtensionBadgeText" Text=".FILE" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource CanvasOnAccentBrush}"
                       AutomationProperties.AutomationId="PreviewExtensionBadge" />
          </Border>

          <Border Background="{StaticResource CanvasCardBrush}" BorderBrush="{StaticResource CanvasBorderBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="6,2">
            <TextBlock x:Name="FileSizeBadgeText" Text="0 KB" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource CanvasSecondaryBrush}"
                       AutomationProperties.AutomationId="PreviewFileSizeBadge" />
          </Border>

          <Border x:Name="DimensionsBadgeBorder" Background="{StaticResource CanvasCardBrush}"
                  BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="6,2" Visibility="Collapsed">
            <TextBlock x:Name="DimensionsBadgeText" Text="0 × 0 px" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource CanvasAccentGlowBrush}"
                       AutomationProperties.AutomationId="PreviewDimensionsBadge" />
          </Border>
        </StackPanel>
      </StackPanel>

      <!-- Controles de la cabecera: Comparación Procesado/Original y Navegación de hermanos -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <!-- Selector Procesado / Original -->
        <Border x:Name="ComparisonPanel" Background="{StaticResource CanvasCardBrush}"
                BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="2" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Name="ToggleProcessedButton" Padding="8,3" FontSize="11"
                    BorderThickness="0" CornerRadius="4"
                    Click="OnToggleProcessedClicked"
                    AutomationProperties.AutomationId="PreviewToggleProcessed">
              <TextBlock x:Name="LabelProcessed" Text="Procesado" FontSize="11" />
            </Button>
            <Button x:Name="ToggleOriginalButton" Padding="8,3" FontSize="11"
                    BorderThickness="0" CornerRadius="4"
                    Click="OnToggleOriginalClicked"
                    AutomationProperties.AutomationId="PreviewToggleOriginal">
              <TextBlock x:Name="LabelOriginal" Text="Original" FontSize="11" />
            </Button>
          </StackPanel>
        </Border>

        <!-- Navegación entre archivos hermanos -->
        <Border x:Name="NavigationPanel" Background="{StaticResource CanvasCardBrush}"
                BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="4,2" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button x:Name="PrevSiblingButton" Padding="8,4" FontSize="12"
                    BorderThickness="0" Background="Transparent"
                    Click="OnPrevSiblingClicked"
                    AutomationProperties.AutomationId="PreviewPrevButton">
              <TextBlock Text="&lt;" FontSize="11" FontWeight="Bold" />
            </Button>

            <TextBlock x:Name="SiblingCounterText" Text="1 de 1" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource CanvasSecondaryBrush}"
                       AutomationProperties.AutomationId="PreviewCounterText" />

            <Button x:Name="NextSiblingButton" Padding="8,4" FontSize="12"
                    BorderThickness="0" Background="Transparent"
                    Click="OnNextSiblingClicked"
                    AutomationProperties.AutomationId="PreviewNextButton">
              <TextBlock Text="&gt;" FontSize="11" FontWeight="Bold" />
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- 1. CONTENIDO PRINCIPAL: VISOR Y PANEL DE METADATOS -->
    <Grid Grid.Row="1" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="MetadataColumn" Width="280" />
      </Grid.ColumnDefinitions>

      <!-- Contenedor del visor -->
      <Border Grid.Column="0" Background="{StaticResource CanvasCardBrush}"
              BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1"
              CornerRadius="8" Padding="1">
        <Grid>
          <!-- A) Visor de Imágenes -->
          <Grid x:Name="ImageViewerPanel" Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="8" MaxHeight="450"
                     AutomationProperties.AutomationId="PreviewImage" />
            </ScrollViewer>
          </Grid>

          <!-- B) Visor de Texto / Código -->
          <Grid x:Name="TextViewerPanel" Visibility="Collapsed" RowSpacing="4">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="PreviewTextBox" Grid.Row="0" IsReadOnly="True" AcceptsReturn="True"
                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5"
                     TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                     Padding="12" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Foreground="{StaticResource CanvasTextBrush}"
                     AutomationProperties.AutomationId="PreviewTextBox" />

            <Border Grid.Row="1" Background="{StaticResource CanvasSurfaceBrush}"
                    BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="12,5">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="TextStatsLabel" FontSize="10"
                           Foreground="{StaticResource CanvasSecondaryBrush}" />
                <TextBlock x:Name="TextTruncatedWarning" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource CanvasWarningBrush}"
                           Visibility="Collapsed" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- C) Visor de Archivo Genérico / Binario -->
          <Grid x:Name="GenericViewerPanel" Visibility="Collapsed" VerticalAlignment="Center"
                HorizontalAlignment="Center" Margin="24">
            <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="400">
              <Border Background="{StaticResource CanvasSurfaceBrush}" CornerRadius="12"
                      BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1"
                      Width="72" Height="72" HorizontalAlignment="Center">
                <TextBlock x:Name="GenericFileIcon" Text="📄" FontSize="32"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>

              <TextBlock x:Name="GenericFileName" FontSize="14" FontWeight="Bold"
                         HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                         Foreground="{StaticResource CanvasTextBrush}" />

              <TextBlock x:Name="GenericFileDescription" FontSize="11"
                         HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                         Foreground="{StaticResource CanvasSecondaryBrush}" />

              <TextBlock x:Name="GenericFileInfo" FontSize="11"
                         HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                         Foreground="{StaticResource CanvasTextBrush}" />

              <Button x:Name="GenericOpenButton" Click="OnOpenFileClicked"
                      HorizontalAlignment="Center" Padding="14,6" Margin="0,8,0,0"
                      Background="{StaticResource CanvasAccentPrimaryBrush}"
                      Foreground="{StaticResource CanvasOnAccentBrush}"
                      AutomationProperties.AutomationId="PreviewGenericOpenButton">
                <TextBlock x:Name="GenericOpenButtonText" Text="🚀 Abrir con aplicación del sistema"
                           FontSize="11" FontWeight="SemiBold" />
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- Panel Lateral de Metadatos -->
      <Border x:Name="MetadataPanel" Grid.Column="1" Background="{StaticResource CanvasCardBrush}"
              BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1"
              CornerRadius="8" Padding="10">
        <Grid RowSpacing="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
            <TextBlock Text="📋" FontSize="12" VerticalAlignment="Center" />
            <TextBlock x:Name="MetadataTitleText" Text="Metadatos e Información" FontSize="12"
                       FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{StaticResource CanvasTextBrush}" />
          </StackPanel>

          <ListView x:Name="MetadataListView" Grid.Row="1" SelectionMode="None"
                    Background="Transparent" BorderThickness="0"
                    AutomationProperties.AutomationId="PreviewMetadataList">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="85" MaxWidth="120" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="10.5" FontWeight="SemiBold"
                             Foreground="{StaticResource CanvasSecondaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10.5"
                             Foreground="{StaticResource CanvasTextBrush}"
                             TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
    </Grid>

    <!-- 2. PIE Y BARRA DE ACCIONES -->
    <Grid Grid.Row="2" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Ruta completa del archivo mostrado -->
      <TextBlock x:Name="DisplayedPathText" Grid.Column="0" FontSize="10.5"
                 Foreground="{StaticResource CanvasSecondaryBrush}"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                 AutomationProperties.AutomationId="PreviewDisplayedPath" />

      <!-- Botones de acción rápida -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button x:Name="CopyPathButton" Click="OnCopyPathClicked" Padding="10,5"
                AutomationProperties.AutomationId="PreviewCopyPathButton">
          <TextBlock x:Name="CopyPathLabel" Text="📋 Copiar Ruta" FontSize="11" />
        </Button>

        <Button x:Name="OpenExplorerButton" Click="OnOpenExplorerClicked" Padding="10,5"
                AutomationProperties.AutomationId="PreviewOpenExplorerButton">
          <TextBlock x:Name="OpenExplorerLabel" Text="📁 Explorador" FontSize="11" />
        </Button>

        <Button x:Name="OpenFileButton" Click="OnOpenFileClicked" Padding="10,5"
                AutomationProperties.AutomationId="PreviewOpenFileButton">
          <TextBlock x:Name="OpenFileLabel" Text="🚀 Abrir" FontSize="11" />
        </Button>

        <Button x:Name="CloseButton" Click="OnCloseClicked" Padding="12,5"
                AutomationProperties.AutomationId="PreviewCloseButton">
          <TextBlock x:Name="CloseLabel" Text="Cerrar" FontSize="11" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

<UserControl
    x:Class="FileFlow.App.Uno.Controls.LogPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileFlow.App.Uno.Controls">

  <Grid Background="{StaticResource CanvasSurfaceBrush}"
        BorderBrush="{StaticResource CanvasBorderBrush}"
        BorderThickness="0,1,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /> <!-- 0: Barra de herramientas superior -->
      <RowDefinition Height="Auto" /> <!-- 1: Barra de progreso sutil -->
      <RowDefinition Height="*" />    <!-- 2: Lista virtualizada de registros -->
    </Grid.RowDefinitions>

    <!-- ── 0: Barra de herramientas unificada ── -->
    <Border Grid.Row="0"
            Background="{StaticResource CanvasCardBrush}"
            BorderBrush="{StaticResource CanvasBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,6">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" /> <!-- Título y filtros de severidad -->
          <ColumnDefinition Width="*" />    <!-- Búsqueda instantánea -->
          <ColumnDefinition Width="Auto" /> <!-- Acciones (en vivo, exportar, limpiar, colapsar) -->
        </Grid.ColumnDefinitions>

        <!-- Izquierda: Título y pastillas de nivel -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock x:Name="TxtTitle"
                     Text="💻 Consola"
                     FontWeight="SemiBold"
                     FontSize="12"
                     Foreground="{StaticResource CanvasTextBrush}"
                     VerticalAlignment="Center" />

          <Border Background="{StaticResource CanvasBorderBrush}" Width="1" Height="16" VerticalAlignment="Center" Margin="2,0" />

          <!-- Filtros de severidad estilo pastillas / chips -->
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button x:Name="BtnFilterAll" Click="OnFilterAllClicked"
                    Padding="8,3" FontSize="11" CornerRadius="12"
                    BorderThickness="1" BorderBrush="{StaticResource CanvasBorderBrush}"
                    Background="{StaticResource CanvasSurfaceBrush}">
              <TextBlock x:Name="TxtFilterAll" Text="Todos" FontSize="11" Foreground="{StaticResource CanvasTextBrush}" />
            </Button>

            <Button x:Name="BtnFilterErrors" Click="OnFilterErrorsClicked"
                    Padding="8,3" FontSize="11" CornerRadius="12"
                    BorderThickness="1" BorderBrush="{StaticResource CanvasBorderBrush}"
                    Background="{StaticResource CanvasSurfaceBrush}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="TxtFilterErrors" Text="Errores" FontSize="11" Foreground="{StaticResource CanvasTextBrush}" />
                <Border x:Name="BadgeErrors" Background="{StaticResource CanvasErrorBrush}" CornerRadius="8" Padding="5,0"
                        Visibility="Collapsed">
                  <TextBlock x:Name="TxtErrorCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White" />
                </Border>
              </StackPanel>
            </Button>

            <Button x:Name="BtnFilterWarnings" Click="OnFilterWarningsClicked"
                    Padding="8,3" FontSize="11" CornerRadius="12"
                    BorderThickness="1" BorderBrush="{StaticResource CanvasBorderBrush}"
                    Background="{StaticResource CanvasSurfaceBrush}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="TxtFilterWarnings" Text="Avisos" FontSize="11" Foreground="{StaticResource CanvasTextBrush}" />
                <Border x:Name="BadgeWarnings" Background="{StaticResource CanvasWarningBrush}" CornerRadius="8" Padding="5,0"
                        Visibility="Collapsed">
                  <TextBlock x:Name="TxtWarningCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White" />
                </Border>
              </StackPanel>
            </Button>

            <Button x:Name="BtnFilterInfo" Click="OnFilterInfoClicked"
                    Padding="8,3" FontSize="11" CornerRadius="12"
                    BorderThickness="1" BorderBrush="{StaticResource CanvasBorderBrush}"
                    Background="{StaticResource CanvasSurfaceBrush}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="TxtFilterInfo" Text="Info" FontSize="11" Foreground="{StaticResource CanvasTextBrush}" />
                <Border x:Name="BadgeInfo" Background="{StaticResource CanvasAccentPrimaryBrush}" CornerRadius="8" Padding="5,0"
                        Visibility="Collapsed">
                  <TextBlock x:Name="TxtInfoCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White" />
                </Border>
              </StackPanel>
            </Button>

            <Button x:Name="BtnFilterDebug" Click="OnFilterDebugClicked"
                    Padding="8,3" FontSize="11" CornerRadius="12"
                    BorderThickness="1" BorderBrush="{StaticResource CanvasBorderBrush}"
                    Background="{StaticResource CanvasSurfaceBrush}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="TxtFilterDebug" Text="Debug" FontSize="11" Foreground="{StaticResource CanvasTextBrush}" />
                <Border x:Name="BadgeDebug" Background="{StaticResource CanvasPurpleBrush}" CornerRadius="8" Padding="5,0"
                        Visibility="Collapsed">
                  <TextBlock x:Name="TxtDebugCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White" />
                </Border>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- Centro: Búsqueda instantánea -->
        <Border Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="360"
                Background="{StaticResource CanvasSurfaceBrush}"
                BorderBrush="{StaticResource CanvasBorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
          <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="🔍" FontSize="11" VerticalAlignment="Center" Opacity="0.6" />
            <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="OnSearchTextChanged"
                     PlaceholderText="Buscar logs..." FontSize="11"
                     BorderThickness="0" Background="Transparent"
                     VerticalAlignment="Center" Padding="2,0" />
            <Button x:Name="BtnClearSearch" Grid.Column="2" Click="OnClearSearchClicked"
                    Padding="4,1" FontSize="10" Background="Transparent" BorderThickness="0"
                    Visibility="Collapsed" VerticalAlignment="Center">
              <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource CanvasSecondaryBrush}" />
            </Button>
          </Grid>
        </Border>

        <!-- Derecha: Acciones auxiliares -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock x:Name="TxtTotalLogs" Text="0 registros" FontSize="11"
                     Foreground="{StaticResource CanvasSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />

          <!-- Toggle En Vivo -->
          <ToggleButton x:Name="BtnLiveToggle" Click="OnLiveToggleClicked"
                        IsChecked="True" Padding="8,4" FontSize="11" CornerRadius="6"
                        BorderThickness="1" BorderBrush="{StaticResource CanvasBorderBrush}">
            <TextBlock x:Name="TxtLive" Text="⚡ En Vivo" FontSize="11" />
          </ToggleButton>

          <!-- Exportar -->
          <Button x:Name="BtnExport" Click="OnExportClicked"
                  Padding="8,4" FontSize="11" CornerRadius="6"
                  BorderThickness="1" BorderBrush="{StaticResource CanvasBorderBrush}"
                  Background="Transparent">
            <TextBlock x:Name="TxtExport" Text="💾 Exportar" FontSize="11" Foreground="{StaticResource CanvasTextBrush}" />
          </Button>

          <!-- Limpiar -->
          <Button x:Name="BtnClear" Click="OnClearClicked"
                  Padding="8,4" FontSize="11" CornerRadius="6"
                  BorderThickness="1" BorderBrush="{StaticResource CanvasBorderBrush}"
                  Background="Transparent">
            <TextBlock x:Name="TxtClear" Text="🗑 Limpiar" FontSize="11" Foreground="{StaticResource CanvasTextBrush}" />
          </Button>

          <!-- Minimizar / Cerrar panel -->
          <Button x:Name="BtnCollapse" Click="OnCollapseClicked"
                  Padding="6,4" FontSize="11" CornerRadius="6"
                  BorderThickness="1" BorderBrush="{StaticResource CanvasBorderBrush}"
                  Background="Transparent" ToolTipService.ToolTip="Ocultar panel de logs">
            <TextBlock Text="─" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CanvasTextBrush}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── 1: Barra de progreso sutil ── -->
    <ProgressBar x:Name="SlimProgressBar" Grid.Row="1"
                 Height="2" Minimum="0" Maximum="100" Value="0"
                 Visibility="Collapsed"
                 Foreground="{StaticResource CanvasAccentPrimaryBrush}"
                 Background="Transparent" BorderThickness="0" />

    <!-- ── 2: Lista virtualizada de registros ── -->
    <ListView x:Name="LogListView" Grid.Row="2"
              AutomationProperties.AutomationId="LogScrollSurface"
              SelectionMode="None"
              IsItemClickEnabled="True"
              ItemClick="OnLogItemClicked"
              PointerWheelChanged="OnLogListViewPointerWheelChanged"
              Padding="4,2">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0,1" />
          <Setter Property="MinHeight" Value="0" />
        </Style>
      </ListView.ItemContainerStyle>

      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:LogItemViewModel">
          <Border Background="{StaticResource CanvasCardBrush}"
                  BorderBrush="{StaticResource CanvasBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="6,4"
                  Margin="0,1">
            <StackPanel Spacing="4">
              <!-- Línea resumida principal (Cabecera siempre visible) -->
              <Grid ColumnSpacing="6" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" /> <!-- Chevron de expansión -->
                  <ColumnDefinition Width="Auto" /> <!-- Timestamp -->
                  <ColumnDefinition Width="Auto" /> <!-- Badge de severidad -->
                  <ColumnDefinition Width="Auto" /> <!-- Nodo (si aplica) -->
                  <ColumnDefinition Width="Auto" /> <!-- Archivo / Ítem (si aplica) -->
                  <ColumnDefinition Width="Auto" /> <!-- Indicador JSON -->
                  <ColumnDefinition Width="*" />    <!-- Mensaje resumido -->
                </Grid.ColumnDefinitions>

                <!-- Chevron -->
                <TextBlock Grid.Column="0" Text="{x:Bind ChevronGlyph, Mode=OneWay}"
                           FontSize="11" Width="12" TextAlignment="Center"
                           Foreground="{StaticResource CanvasSecondaryBrush}"
                           VerticalAlignment="Center" />

                <!-- Hora -->
                <TextBlock Grid.Column="1" Text="{x:Bind FormattedTimestamp, Mode=OneWay}"
                           FontSize="11" FontFamily="Consolas, Cascadia Code, Courier New"
                           Foreground="{StaticResource CanvasSecondaryBrush}"
                           VerticalAlignment="Center" />

                <!-- Badge Severidad -->
                <Border Grid.Column="2"
                        Background="{x:Bind LevelBadgeBackground, Mode=OneWay}"
                        CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}"
                             FontSize="9" FontWeight="Bold"
                             Foreground="{x:Bind LevelBadgeForeground, Mode=OneWay}"
                             VerticalAlignment="Center" />
                </Border>

                <!-- Nodo -->
                <Border Grid.Column="3" Background="{StaticResource CanvasSurfaceBrush}"
                        CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                        Visibility="{x:Bind HasNode, Mode=OneWay}">
                  <TextBlock Text="{x:Bind NodeName, Mode=OneWay}"
                             FontSize="10" FontWeight="SemiBold"
                             Foreground="{StaticResource CanvasAccentPrimaryBrush}"
                             VerticalAlignment="Center" />
                </Border>

                <!-- Archivo -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind HasFile, Mode=OneWay}">
                  <TextBlock Text="📄" FontSize="10" VerticalAlignment="Center" />
                  <TextBlock Text="{x:Bind FileName, Mode=OneWay}"
                             FontSize="10" Foreground="{StaticResource CanvasSecondaryBrush}"
                             VerticalAlignment="Center" />
                </StackPanel>

                <!-- Badge JSON -->
                <Border Grid.Column="5" Background="#AB47BC"
                        CornerRadius="3" Padding="3,1" VerticalAlignment="Center"
                        Visibility="{x:Bind HasDetails, Mode=OneWay}">
                  <TextBlock Text="{}{ } JSON" FontSize="9" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                </Border>

                <!-- Mensaje resumido de una sola línea -->
                <TextBlock Grid.Column="6" Text="{x:Bind Message, Mode=OneWay}"
                           FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource CanvasTextBrush}"
                           VerticalAlignment="Center" />
              </Grid>

              <!-- Sección expandida con detalles completos y JSON estructurado -->
              <Border Visibility="{x:Bind DetailsVisibility, Mode=OneWay}"
                      Background="{StaticResource CanvasSurfaceBrush}"
                      BorderBrush="{StaticResource CanvasBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="10,8"
                      Margin="16,4,4,4">
                <StackPanel Spacing="6">
                  <!-- Metadatos de la entrada -->
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                      <TextBlock Text="{x:Bind DurationText, Mode=OneWay}"
                                 FontSize="10" Foreground="{StaticResource CanvasSecondaryBrush}"
                                 Visibility="{x:Bind HasDuration, Mode=OneWay}" />

                      <TextBlock Text="{x:Bind FormattedShortItemId, Mode=OneWay}"
                                 FontSize="10" FontWeight="Bold"
                                 Foreground="{StaticResource CanvasAccentPrimaryBrush}"
                                 Visibility="{x:Bind HasItemId, Mode=OneWay}" />

                      <TextBlock Text="{x:Bind FilePath, Mode=OneWay}"
                                 FontSize="10" Foreground="{StaticResource CanvasSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 Visibility="{x:Bind HasFilePath, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Acciones rápidas de copia -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                      <Button Click="OnCopyMessageClicked" Padding="6,2" FontSize="10"
                              BorderThickness="1" BorderBrush="{StaticResource CanvasBorderBrush}"
                              Background="{StaticResource CanvasCardBrush}">
                        <TextBlock Text="Copiar Mensaje" FontSize="10" Foreground="{StaticResource CanvasTextBrush}" />
                      </Button>
                      <Button Click="OnCopyFullLineClicked" Padding="6,2" FontSize="10"
                              BorderThickness="1" BorderBrush="{StaticResource CanvasBorderBrush}"
                              Background="{StaticResource CanvasCardBrush}">
                        <TextBlock Text="Copiar Línea" FontSize="10" Foreground="{StaticResource CanvasTextBrush}" />
                      </Button>
                      <Button Click="OnCopyFilePathClicked" Padding="6,2" FontSize="10"
                              BorderThickness="1" BorderBrush="{StaticResource CanvasBorderBrush}"
                              Background="{StaticResource CanvasCardBrush}"
                              Visibility="{x:Bind HasFilePath, Mode=OneWay}">
                        <TextBlock Text="Copiar Ruta" FontSize="10" Foreground="{StaticResource CanvasTextBrush}" />
                      </Button>
                    </StackPanel>
                  </Grid>

                  <!-- Mensaje Completo (multilínea seleccionable) -->
                  <TextBox Text="{x:Bind Message, Mode=OneWay}"
                           IsReadOnly="True"
                           TextWrapping="Wrap"
                           FontSize="11"
                           BorderThickness="0"
                           Background="Transparent"
                           Foreground="{StaticResource CanvasTextBrush}"
                           Padding="0" />

                  <!-- Visualizador de JSON con formato -->
                  <Border Visibility="{x:Bind HasDetails, Mode=OneWay}"
                          Background="{StaticResource CanvasBackgroundBrush}"
                          BorderBrush="{StaticResource CanvasBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="4"
                          Padding="8,6"
                          Margin="0,4,0,0">
                    <StackPanel Spacing="4">
                      <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <TextBlock Text="{}{ } Datos JSON estructurados" FontSize="10" FontWeight="Bold"
                                     Foreground="{StaticResource CanvasAccentPrimaryBrush}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Click="OnCopyJsonClicked"
                                Padding="6,2" FontSize="10"
                                BorderThickness="1" BorderBrush="{StaticResource CanvasBorderBrush}"
                                Background="{StaticResource CanvasCardBrush}">
                          <TextBlock Text="📋 Copiar JSON" FontSize="10" Foreground="{StaticResource CanvasTextBrush}" />
                        </Button>
                      </Grid>

                      <TextBox Text="{x:Bind DisplayDetails, Mode=OneWay}"
                               IsReadOnly="True"
                               TextWrapping="Wrap"
                               FontFamily="Consolas, Cascadia Code, Courier New"
                               FontSize="11"
                               BorderThickness="0"
                               Background="Transparent"
                               Foreground="{StaticResource CanvasTextBrush}"
                               Padding="2" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <!-- Píldora de «nuevos registros»: cuando el usuario NO está al fondo, la consola deja de arrastrar
         la vista y en su lugar ofrece volver a ella. Es la otra mitad del stick-to-bottom: perseguir la
         cola sin más era el «se mueve el panel de logs» que se veía con el cursor en otra parte. -->
    <Button x:Name="NewLogsPill" Grid.Row="2"
            AutomationProperties.AutomationId="LogNewRecordsPill"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
            Click="OnNewLogsPillClicked" Visibility="Collapsed"
            Padding="12,6" CornerRadius="14" FontSize="11"
            Background="{StaticResource CanvasAccentPrimaryBrush}" BorderThickness="0"
            ToolTipService.ToolTip="Volver al final de la consola">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="↓" FontWeight="Bold" Foreground="{StaticResource CanvasOnAccentBrush}" />
        <TextBlock x:Name="NewLogsPillCount" Text="0" FontWeight="Bold"
                   Foreground="{StaticResource CanvasOnAccentBrush}" />
        <TextBlock x:Name="NewLogsPillLabel" Text="nuevos registros"
                   Foreground="{StaticResource CanvasOnAccentBrush}" />
      </StackPanel>
    </Button>
  </Grid>
</UserControl>

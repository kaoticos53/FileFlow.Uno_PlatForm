<Window
    x:Class="FileFlow.App.Uno.SplashScreenWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileFlow.App.Uno.Controls"
    Title="FileFlow Studio">

  <Grid x:Name="RootGrid" Background="{StaticResource CanvasSurfaceBrush}">
    <controls:SplashScreenView x:Name="SplashView"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />
  </Grid>
</Window>
